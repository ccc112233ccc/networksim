  "mice": {
    "source_start": 0,
    "source_count": 32,
    "destination": 128,
    "bytes_per_flow": 262144,
    "operation": "URMA_WRITE",
    "priority": 7,
    "start": "100us"
  },
  "elephants": {
    "source_start": 256,
    "source_count": 8,
    "bytes_per_flow": 16777216,
    "operation": "URMA_WRITE",
    "priority": 7,
    "start": "0ns"
