  "cases": [
    {
      "name": "mice-only",
      "description": "No elephant background traffic.",
      "default": true,
      "elephant_destination": null
    },
    {
      "name": "elephant-disjoint",
      "description": "Eight elephants use a different destination final link (node 192).",
      "default": true,
      "elephant_destination": 192
    },
    {
      "name": "elephant-shared",
      "description": "Eight elephants and the mice share node 128 port 0 and VL7.",
      "default": true,
      "elephant_destination": 128
    },
    {
      "name": "elephant-shared-mice-vl1",
      "description": "Shared final link, but mice use high-priority VL1 and elephants remain on VL7.",
      "default": true,
      "elephant_destination": 128,
      "mice_priority": 1
    }
  ]
